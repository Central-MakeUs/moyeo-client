{
  "name": "next-webview-turbo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@repo/web --filter=docs",
    "dev:native": "pnpm --filter native start",
    "lint": "turbo run lint",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "turbo run check-types",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/web/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix --config apps/web/eslint.config.mjs",
      "prettier --write --config apps/web/prettier.config.mjs"
    ],
    "apps/web/**/*.{css,md,mdx,json}": [
      "prettier --write --config apps/web/prettier.config.mjs"
    ],
    "apps/docs/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix --config apps/docs/eslint.config.mjs",
      "prettier --write"
    ],
    "apps/native/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix --config apps/native/eslint.config.mjs",
      "prettier --write"
    ],
    "packages/ui/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix --config packages/ui/eslint.config.mjs",
      "prettier --write"
    ],
    "*.{js,mjs,json,md,mdx,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@repo/prettier-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.7.4",
    "turbo": "^2.10.0",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}

# apps/web 환경변수 예시. 실제 값은 .env.local 에 두며 커밋하지 않는다.
# 클라이언트에 노출되는 값만 NEXT_PUBLIC_ 접두사를 쓴다.

# API 서버 주소. 프록시를 사용하지 않는 브라우저와 서버 측 API 호출이 사용한다.
NEXT_PUBLIC_API_BASE_URL=https://3-35-119-70.sslip.io

# 로컬 WebView 개발에서 사용할 동일 origin 프록시 경로.
# 비워두면 브라우저도 NEXT_PUBLIC_API_BASE_URL 로 백엔드를 직접 호출한다.
NEXT_PUBLIC_API_PROXY_PATH=/backend-api

# 같은 API 서버 주소지만 Route Handler 프록시가 서버에서만 사용한다.
# /backend-api/* 요청을 이 주소로 전달하며, 클라이언트 번들에 들어가면 안 되므로 NEXT_PUBLIC_ 을 붙이지 않는다.
#
# 비어 있으면 Route Handler가 백엔드 주소를 만들 수 없어 502를 반환한다.
API_BASE_URL=https://3-35-119-70.sslip.io

# 실기기에서 LAN IP 로 dev 서버에 접속할 때 허용할 오리진. 쉼표로 구분한다.
#
# next.config.js 가 사설망 대역(192.168.*, 172.16~31.*, 10.*)을 이미 열어두므로 보통은 비워둔다.
# 그 밖의 대역을 쓰는 망(일부 회사망 등)에서만 추가한다. 값을 바꾸면 dev 서버를 재시작해야 한다.
# (Next 16 은 allowedDevOrigins 에 없는 오리진의 dev 요청을 403 으로 막는다)
ALLOWED_DEV_ORIGINS=

# dev 로그인 패널 노출 플래그. 'true' 일 때만 렌더되고, 꺼진 빌드에서는 번들에서도 빠진다.
# 서버가 2차 잠금을 한다 — POST /api/auth/dev/tokens 는 local·dev 프로필에서만 응답한다.
NEXT_PUBLIC_ENABLE_DEV_AUTH=false

# 모바일 WebView에서 백엔드 dev-auth API 없이 세션을 초기화할 개발용 access token.
# Dev Auth 패널이 활성화된 로컬 환경에서만 설정하고 실제 값을 커밋하지 않는다.
NEXT_PUBLIC_DEV_ACCESS_TOKEN=

# 소셜 로그인 클라이언트 ID (각 공급자 콘솔에서 발급)
NEXT_PUBLIC_APPLE_CLIENT_ID=com.moyeozo.moyeo.web
NEXT_PUBLIC_KAKAO_CLIENT_ID=

# 카카오 JavaScript 키. 카카오 개발자 콘솔의 '앱 키 > JavaScript 키'다.
# 로그인용 CLIENT_ID(REST API 키)와 다른 값이니 섞지 않는다.
# 비어 있으면 CRT-07의 카카오톡 공유 버튼이 안내 토스트만 띄우고 동작하지 않는다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# 서버에 등록된 OAuth 콜백 환경 식별자: local | dev | prod
# Kakao는 세 값을 모두 지원하지만 Apple 웹 로그인은 dev | prod만 지원한다.
NEXT_PUBLIC_OAUTH_REDIRECT_TARGET=local

# OAuth redirect_uri 의 기준 origin.
#
# 비워두면 window.location.origin 을 쓴다. 로컬(localhost:3000) 개발은 그대로 두면 된다.
# 아래 경우에는 반드시 지정해야 한다 — origin 이 공급자 콘솔에 등록되지 않은 주소가 되기 때문이다.
#   - 네이티브 dev 빌드: WebView 가 http://<LAN-IP>:3000 을 띄운다 (Apple 은 http 를 거부한다)
#   - Vercel preview: 배포마다 *-git-*.vercel.app 도메인이 새로 생긴다
#
# 여기에 넣는 값 + /auth/callback/{apple|kakao} 가 공급자 콘솔에 등록한 redirect URI 와
# 문자 단위로 같아야 한다.
NEXT_PUBLIC_OAUTH_REDIRECT_BASE_URL=http://localhost:3000

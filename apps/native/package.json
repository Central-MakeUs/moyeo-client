{
  "name": "native",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "check-types": "tsc --noEmit",
    "build:android:dev": "eas build --profile development --platform android",
    "build:android:preview": "eas build --profile preview --platform android",
    "build:android:prod": "eas build --profile production --platform android",
    "build:ios:dev": "cross-env EXPO_NO_CAPABILITY_SYNC=1 eas build --profile development --platform ios",
    "build:ios:preview": "cross-env EXPO_NO_CAPABILITY_SYNC=1 eas build --profile preview --platform ios",
    "build:ios:testflight": "cross-env EXPO_NO_CAPABILITY_SYNC=1 eas build --profile testflight --platform ios",
    "build:ios:prod": "cross-env EXPO_NO_CAPABILITY_SYNC=1 eas build --profile production --platform ios",
    "build:all:dev": "cross-env EXPO_NO_CAPABILITY_SYNC=1 eas build --profile development --platform all",
    "build:all:preview": "cross-env EXPO_NO_CAPABILITY_SYNC=1 eas build --profile preview --platform all",
    "build:all:prod": "cross-env EXPO_NO_CAPABILITY_SYNC=1 eas build --profile production --platform all",
    "submit:ios:testflight": "eas submit --profile testflight --platform ios",
    "submit:ios:prod": "eas submit --profile production --platform ios",
    "submit:android:prod": "eas submit --profile production --platform android"
  },
  "dependencies": {
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-seoul/kakao-login": "6.0.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.34",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.18",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "~19.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.25.0",
    "typescript": "~5.9.2"
  },
  "private": true
}

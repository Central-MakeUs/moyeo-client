{
  "expo": {
    "name": "모여",
    "slug": "moyeo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moyeo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moyeozo.moyeo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.moyeozo.moyeo",
      "adaptiveIcon": {
        "backgroundColor": "#FFFCFC",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 134,
          "resizeMode": "contain",
          "backgroundColor": "#fef2f2"
        }
      ],
      "expo-secure-store",
      "expo-navigation-bar",
      "expo-notifications",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "autolinkingModuleResolution": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "803023d0-2fee-4c1a-af40-728ea7521444"
      }
    },
    "owner": "moyeozo"
  }
}

{
  "expo": {
    "name": "모여",
    "slug": "moyeo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moyeo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.moyeozo.moyeo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": ["applinks:moyeo-web.vercel.app", "applinks:moyeo-dev.vercel.app"]
    },
    "android": {
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "moyeo-web.vercel.app",
              "pathPrefix": "/i/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "moyeo-dev.vercel.app",
              "pathPrefix": "/i/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "package": "com.moyeozo.moyeo",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/803023d0-2fee-4c1a-af40-728ea7521444"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 134,
          "resizeMode": "contain",
          "backgroundColor": "#fef2f2"
        }
      ],
      "expo-secure-store",
      "expo-navigation-bar",
      "expo-notifications",
      "expo-updates",
      [
        "expo-image-picker",
        {
          "photosPermission": "모임 커버 사진을 등록할 때 사용합니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "autolinkingModuleResolution": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "803023d0-2fee-4c1a-af40-728ea7521444"
      }
    },
    "owner": "moyeozo"
  }
}

{
  "permissions": {
    "allow": [
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm generate:icons)",
      "Bash(pnpm --filter @repo/web lint)",
      "Bash(pnpm --filter @repo/web lint:steiger)",
      "Bash(pnpm --filter @repo/web check-types)",
      "Bash(pnpm --filter @repo/web build)",
      "Bash(pnpm --filter @repo/web orval)",
      "Bash(npx prettier *)",
      "Bash(npx tsc --noEmit*)",
      "Bash(node .claude/hooks/*)",
      "Bash(node scripts/*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git add *)",
      "Bash(git mv *)",
      "Bash(git switch*)",
      "Bash(git stash list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(ls *)",
      "Bash(rg *)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/fsd-layer-check.mjs",
            "timeout": 10,
            "statusMessage": "FSD 경계 검사"
          }
        ]
      }
    ]
  }
}
